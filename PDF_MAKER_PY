#this function delete word file
def delete_word(path,parent_dir):
    os.chdir(path)
    files = [f for f in os.listdir('.') if os.path.isfile(f)]
    for f in files:
        fbasename = os.path.splitext(os.path.basename(f))[0]
        if f.endswith('.docx'):
            os.remove(f)
    os.chdir(parent_dir)        
